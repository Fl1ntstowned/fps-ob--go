{
  "manifest_version": 3,
  "name": "Obi Satoshi's Game Hub",
  "version": "2.1.0",
  "description": "Multiplayer games on Bitcoin ordinals - FPS, Chess, Poker, and more",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://fps-game-backend-production.up.railway.app/*",
    "https://chess-game-backend-production.up.railway.app/*",
    "https://poker-backend.up.railway.app/*",
    "https://*.up.railway.app/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Obi Satoshi's Game Hub"
  }
}
